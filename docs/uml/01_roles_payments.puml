@startuml 01_roles_payments
!pragma layout smetana
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 12
skinparam classBackgroundColor #F7F8FA
skinparam classBorderColor #455568
skinparam ArrowColor #697A8D
skinparam packageStyle rectangle
skinparam nodesep 25
skinparam ranksep 30
hide empty members
title FORGE User roles and payment polymorphism
caption Declared API excerpts. Full signatures and nested types are in CLASS-REFERENCE.md.
abstract class "User" as edu_course_shop_model_User {
  -id : long
  -username : String
  #User(id, username)
  +getId() : long
  +getUsername() : String
  {abstract} +canManageProducts() : boolean
  {abstract} +canShop() : boolean
  {abstract} +getRole() : String
}
class "Admin" as edu_course_shop_model_Admin {
  +Admin(id, username)
  +canManageProducts() : boolean
  +canShop() : boolean
  +getRole() : String
}
class "Customer" as edu_course_shop_model_Customer {
  +Customer(id, username)
  +canManageProducts() : boolean
  +canShop() : boolean
  +getRole() : String
}
class "Guest" as edu_course_shop_model_Guest {
  +Guest()
  +canManageProducts() : boolean
  +canShop() : boolean
  +getRole() : String
}
interface "PaymentMethod" as edu_course_shop_payment_PaymentMethod {
  +getName() : String
  +pay(amount) : PaymentResult
}
class "CashOnDeliveryPayment" as edu_course_shop_payment_CashOnDeliveryPayment {
  +getName() : String
  +pay(amount) : PaymentResult
  +toString() : String
}
class "SimulatedWalletPayment" as edu_course_shop_payment_SimulatedWalletPayment {
  -approved : boolean
  +SimulatedWalletPayment(approved)
  +getName() : String
  +pay(amount) : PaymentResult
  +toString() : String
}
class "PaymentResult" as edu_course_shop_payment_PaymentResult <<record>> {
  -accepted : boolean
  -status : String
  .. public component accessors generated by Java ..
}
edu_course_shop_model_Admin -[hidden]down-> edu_course_shop_model_Guest
edu_course_shop_model_Customer -[hidden]down-> edu_course_shop_payment_PaymentMethod
edu_course_shop_model_Customer -[hidden]right-> edu_course_shop_model_Guest
edu_course_shop_model_Guest -[hidden]down-> edu_course_shop_payment_CashOnDeliveryPayment
edu_course_shop_model_User -[hidden]down-> edu_course_shop_model_Customer
edu_course_shop_model_User -[hidden]right-> edu_course_shop_model_Admin
edu_course_shop_model_User <|-- edu_course_shop_model_Admin
edu_course_shop_model_User <|-- edu_course_shop_model_Customer
edu_course_shop_model_User <|-- edu_course_shop_model_Guest
edu_course_shop_payment_CashOnDeliveryPayment -[hidden]down-> edu_course_shop_payment_PaymentResult
edu_course_shop_payment_CashOnDeliveryPayment ..> edu_course_shop_payment_PaymentResult : returns
edu_course_shop_payment_PaymentMethod -[hidden]down-> edu_course_shop_payment_SimulatedWalletPayment
edu_course_shop_payment_PaymentMethod -[hidden]right-> edu_course_shop_payment_CashOnDeliveryPayment
edu_course_shop_payment_PaymentMethod <|.. edu_course_shop_payment_CashOnDeliveryPayment
edu_course_shop_payment_PaymentMethod <|.. edu_course_shop_payment_SimulatedWalletPayment
edu_course_shop_payment_SimulatedWalletPayment -[hidden]right-> edu_course_shop_payment_PaymentResult
edu_course_shop_payment_SimulatedWalletPayment ..> edu_course_shop_payment_PaymentResult : returns
note bottom of edu_course_shop_payment_PaymentMethod
CheckoutService holds PaymentMethod and calls pay(total).
COD returns PENDING; approved wallet returns PAID; declined wallet rejects checkout.
end note
