@startuml 07_ai_manager
!pragma layout smetana
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 12
skinparam classBackgroundColor #F7F8FA
skinparam classBorderColor #455568
skinparam ArrowColor #697A8D
skinparam packageStyle rectangle
skinparam nodesep 25
skinparam ranksep 30
hide empty members
title FORGE AI Manager commands reviewed changes and sales
caption Declared API excerpts. Full signatures and nested types are in CLASS-REFERENCE.md.
class "ManagerCommand" as edu_course_shop_service_ManagerCommand <<record>> {
  -intent : Intent
  -query : String
  -category : Category
  -belowPrice : BigDecimal
  -stockAtMost : Integer
  -stockAtLeast : Integer
  -status : String
  -targetActive : Boolean
  -missingContent : boolean
  -missingField : String
  -ids : List<Long>
  -period : String
  +ManagerCommand(...)
  +matches(p) : boolean
  {static} +needsContent(p) : boolean
  {static} ~parse(tool, args) : ManagerCommand
  {static} ~arguments(intent) : Set<String>
  {static} ~offline(request) : ManagerCommand
  .. public component accessors generated by Java ..
}
class "ManagerAi" as edu_course_shop_service_ManagerAi {
  -gemini : GeminiAssistant
  +ManagerAi(gemini)
  ~classify(command) : ManagerCommand
  ~draft(products, research) : List<Draft>
  +configured() : boolean
  +configurationProblem() : String
  {static} ~validSource(text) : boolean
}
class "AiManagerService" as edu_course_shop_service_AiManagerService {
  -services : Services
  -ai : ManagerAi
  -clock : Clock
  +AiManagerService(services, gemini)
  +configured() : boolean
  +metrics(actor) : Metrics
  +prepare(actor, request, research) : Result
  +apply(actor, result) : void
}
class "RevenueAnalytics" as edu_course_shop_service_RevenueAnalytics {
  {static} +calculate(orders, start, end, clock) : Report
}
edu_course_shop_service_AiManagerService --> edu_course_shop_service_ManagerAi : ai
edu_course_shop_service_ManagerAi -[hidden]right-> edu_course_shop_service_AiManagerService
edu_course_shop_service_ManagerCommand -[hidden]down-> edu_course_shop_service_RevenueAnalytics
edu_course_shop_service_ManagerCommand -[hidden]right-> edu_course_shop_service_ManagerAi
@enduml
