@startuml 04_checkout_services
!pragma layout smetana
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 12
skinparam classBackgroundColor #F7F8FA
skinparam classBorderColor #455568
skinparam ArrowColor #697A8D
skinparam packageStyle rectangle
skinparam nodesep 25
skinparam ranksep 30
hide empty members
title FORGE Authentication carts and checkout services
caption Declared API excerpts. Full signatures and nested types are in CLASS-REFERENCE.md.
class "AuthService" as edu_course_shop_service_AuthService {
  -database : DatabaseManager
  -users : UserRepository
  +AuthService(database, users)
  +accounts() : AccountService
  +login(username, password) : User
}
class "Passwords" as edu_course_shop_service_Passwords {
  {static} +hash(password) : String
  {static} +matches(password, stored) : boolean
}
class "CartService" as edu_course_shop_service_CartService {
  -products : ProductService
  +CartService(products)
  +add(user, cart, productId, quantity) : void
  +update(user, cart, productId, quantity) : void
  +transferGuest(guest, customer) : Cart
  +review(cart) : String
  {static} +checkOwner(user, cart) : void
}
class "PersistentCartService" as edu_course_shop_service_PersistentCartService {
  -database : DatabaseManager
  -products : ProductRepository
  +PersistentCartService(database, products)
  +restore(user, guest) : Restored
}
class "CheckoutService" as edu_course_shop_service_CheckoutService {
  -database : DatabaseManager
  -products : ProductRepository
  -orders : OrderRepository
  +CheckoutService(database, products, orders)
  +checkout(customer, cart, address, payment) : Order
}
class "OrderService" as edu_course_shop_service_OrderService {
  -database : DatabaseManager
  -orders : OrderRepository
  +OrderService(database, orders)
  +history(customer) : List<Order>
  +get(actor, id) : Order
  +recordDeliveryPayment(admin, id) : Order
  +update(admin, id, expected, next, carrier, tracking) : Order
  +cancel(customer, id, expected) : Order
}
edu_course_shop_service_AuthService -[hidden]down-> edu_course_shop_service_PersistentCartService
edu_course_shop_service_AuthService -[hidden]right-> edu_course_shop_service_Passwords
edu_course_shop_service_CartService -[hidden]down-> edu_course_shop_service_OrderService
edu_course_shop_service_CheckoutService -[hidden]right-> edu_course_shop_service_OrderService
edu_course_shop_service_Passwords -[hidden]down-> edu_course_shop_service_CheckoutService
edu_course_shop_service_Passwords -[hidden]right-> edu_course_shop_service_CartService
edu_course_shop_service_PersistentCartService -[hidden]right-> edu_course_shop_service_CheckoutService
@enduml
