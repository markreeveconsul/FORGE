@startuml 02_products_carts
!pragma layout smetana
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 12
skinparam classBackgroundColor #F7F8FA
skinparam classBorderColor #455568
skinparam ArrowColor #697A8D
skinparam packageStyle rectangle
skinparam nodesep 25
skinparam ranksep 30
hide empty members
title FORGE Products carts and specifications
caption Declared API excerpts. Full signatures and nested types are in CLASS-REFERENCE.md.
class "Product" as edu_course_shop_model_Product {
  -id : long
  -name : String
  -category : Category
  -price : BigDecimal
  -stock : int
  -active : boolean
  -description : String
  -photo : byte[]
  -additionalPhotos : java.util.List<byte[]>
  -specifications : String
  -photoFrame : PhotoFrame
  +getPhotoFrame() : PhotoFrame
  +Product(id, name, category, price, stock, active)
  +getDescription() : String
  +getPhoto() : byte[]
  +getAdditionalPhotos() : java.util.List<byte[]>
  +getSpecifications() : String
  +getId() : long
  +getName() : String
}
class "Cart" as edu_course_shop_model_Cart {
  -customerId : long
  -items : Map<Long, CartItem>
  -persistence : Consumer<List<CartItem>>
  +Cart(customerId)
  +getItems() : List<CartItem>
  +add(product, quantity) : void
  +setQuantity(product, quantity) : void
  +remove(id) : void
  +clear() : void
  +getTotal() : BigDecimal
  +attachPersistence(save) : void
}
class "CartItem" as edu_course_shop_model_CartItem {
  -product : Product
  -quantity : int
  +CartItem(product, quantity)
  +getProduct() : Product
  +getQuantity() : int
  +getSubtotal() : BigDecimal
}
enum "Category" as edu_course_shop_model_Category {
  PC_SETS
  PC_PARTS
  LAPTOPS
  PHONES_TABLETS
  PERIPHERALS
  ELECTRONICS
  CLOTHING
  HOME
  -label : String
  +label() : String
  +isRetired() : boolean
  {static} +shopping() : List<Category>
  +shoppingIndex() : int
  ~Category(label)
}
class "Money" as edu_course_shop_model_Money {
  {static} +price(value) : BigDecimal
  {static} +parse(text) : BigDecimal
  {static} +cents(amount) : long
  {static} +amount(cents) : BigDecimal
  {static} +format(amount) : String
}
class "PhotoFrame" as edu_course_shop_model_PhotoFrame <<record>> {
  -mode : Mode
  -x : double
  -y : double
  AUTO
  +PhotoFrame(mode, x, y)
  .. public component accessors generated by Java ..
}
class "ProductSpecifications" as edu_course_shop_model_ProductSpecifications {
  {static} -ALIASES : Map<String, String>
  {static} +fields(category) : List<String>
  {static} +canonical(key) : String
  {static} +values(text) : Map<String, String>
  {static} +value(p, key) : String
  {static} +matches(p, filters) : boolean
  {static} +validated(text) : String
  {static} +listingText(text) : String
  {static} +formatWarnings(text) : List<FormatWarning>
}
class "DeliveryAddress" as edu_course_shop_model_DeliveryAddress <<record>> {
  -recipient : String
  -street : String
  -city : String
  -postalCode : String
  +DeliveryAddress(recipient, street, city, postalCode)
  +formatted() : String
  .. public component accessors generated by Java ..
}
edu_course_shop_model_Cart "1" *-- "0..*" edu_course_shop_model_CartItem : owns lines
edu_course_shop_model_Cart -[hidden]down-> edu_course_shop_model_Category
edu_course_shop_model_CartItem --> edu_course_shop_model_Product : product
edu_course_shop_model_CartItem -[hidden]down-> edu_course_shop_model_Money
edu_course_shop_model_CartItem -[hidden]right-> edu_course_shop_model_Category
edu_course_shop_model_Category -[hidden]down-> edu_course_shop_model_PhotoFrame
edu_course_shop_model_Money -[hidden]down-> edu_course_shop_model_ProductSpecifications
edu_course_shop_model_Money -[hidden]right-> edu_course_shop_model_PhotoFrame
edu_course_shop_model_PhotoFrame -[hidden]down-> edu_course_shop_model_DeliveryAddress
edu_course_shop_model_Product --> edu_course_shop_model_Category : category
edu_course_shop_model_Product --> edu_course_shop_model_PhotoFrame : photoFrame
edu_course_shop_model_Product -[hidden]down-> edu_course_shop_model_CartItem
edu_course_shop_model_Product -[hidden]right-> edu_course_shop_model_Cart
edu_course_shop_model_ProductSpecifications -[hidden]right-> edu_course_shop_model_DeliveryAddress
note bottom of edu_course_shop_model_PhotoFrame
Record components are private final fields.
Java generates public accessors mode(), x() and y().
end note
@enduml
