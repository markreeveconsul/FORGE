@startuml 03_orders_reviews
!pragma layout smetana
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 12
skinparam classBackgroundColor #F7F8FA
skinparam classBorderColor #455568
skinparam ArrowColor #697A8D
skinparam packageStyle rectangle
skinparam nodesep 25
skinparam ranksep 30
hide empty members
title FORGE Orders fulfillment and reviews
caption Declared API excerpts. Full signatures and nested types are in CLASS-REFERENCE.md.
class "Order" as edu_course_shop_model_Order <<record>> {
  -id : long
  -customerId : long
  -createdAt : String
  -address : String
  -paymentMethod : String
  -paymentStatus : String
  -total : BigDecimal
  -items : List<OrderItem>
  -fulfillmentStatus : FulfillmentStatus
  -carrier : String
  -trackingNumber : String
  -events : List<OrderEvent>
  +Order(...)
  .. public component accessors generated by Java ..
}
class "OrderItem" as edu_course_shop_model_OrderItem <<record>> {
  -productId : long
  -productName : String
  -unitPrice : BigDecimal
  -quantity : int
  +subtotal() : BigDecimal
  .. public component accessors generated by Java ..
}
class "OrderEvent" as edu_course_shop_model_OrderEvent <<record>> {
  -status : FulfillmentStatus
  -createdAt : String
  -note : String
  .. public component accessors generated by Java ..
}
enum "FulfillmentStatus" as edu_course_shop_model_FulfillmentStatus {
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  -label : String
  +toString() : String
  +next() : List<FulfillmentStatus>
  ~FulfillmentStatus(label)
}
class "ProductReview" as edu_course_shop_model_ProductReview <<record>> {
  -id : long
  -productId : long
  -author : String
  -rating : int
  -text : String
  -createdAt : String
  .. public component accessors generated by Java ..
}
edu_course_shop_model_Order "1" *-- "1..*" edu_course_shop_model_OrderItem : owns snapshots
edu_course_shop_model_Order --> edu_course_shop_model_FulfillmentStatus : fulfillmentStatus
edu_course_shop_model_Order --> edu_course_shop_model_OrderEvent : events
edu_course_shop_model_Order -[hidden]down-> edu_course_shop_model_OrderEvent
edu_course_shop_model_Order -[hidden]right-> edu_course_shop_model_OrderItem
edu_course_shop_model_OrderEvent --> edu_course_shop_model_FulfillmentStatus : status
edu_course_shop_model_OrderEvent -[hidden]down-> edu_course_shop_model_ProductReview
edu_course_shop_model_OrderEvent -[hidden]right-> edu_course_shop_model_FulfillmentStatus
edu_course_shop_model_OrderItem -[hidden]down-> edu_course_shop_model_FulfillmentStatus
@enduml
