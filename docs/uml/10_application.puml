@startuml 10_application
!pragma layout smetana
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 12
skinparam classBackgroundColor #F7F8FA
skinparam classBorderColor #455568
skinparam ArrowColor #697A8D
skinparam packageStyle rectangle
skinparam nodesep 25
skinparam ranksep 30
hide empty members
title FORGE Application wiring and exceptions
caption Declared API excerpts. Full signatures and nested types are in CLASS-REFERENCE.md.
class "ShopApp" as edu_course_shop_ShopApp {
  +start(stage) : void
  {static} +main(args) : void
}
class "Services" as edu_course_shop_Services <<record>> {
  -auth : AuthService
  -products : ProductService
  -checkout : CheckoutService
  -orders : OrderService
  -admin : AdminService
  -reviews : ProductReviewService
  +accounts() : AccountService
  .. public component accessors generated by Java ..
}
class "ValidationException" as edu_course_shop_exception_ValidationException {
  +ValidationException(message)
}
class "OutOfStockException" as edu_course_shop_exception_OutOfStockException {
  +OutOfStockException(name)
}
class "StorageException" as edu_course_shop_exception_StorageException {
  +StorageException(cause)
}
edu_course_shop_Services -[hidden]down-> edu_course_shop_exception_StorageException
edu_course_shop_Services -[hidden]right-> edu_course_shop_exception_ValidationException
edu_course_shop_ShopApp -[hidden]down-> edu_course_shop_exception_OutOfStockException
edu_course_shop_ShopApp -[hidden]right-> edu_course_shop_Services
edu_course_shop_ShopApp ..> edu_course_shop_Services : creates
edu_course_shop_exception_OutOfStockException -[hidden]right-> edu_course_shop_exception_StorageException
edu_course_shop_exception_ValidationException <|-- edu_course_shop_exception_OutOfStockException
@enduml
